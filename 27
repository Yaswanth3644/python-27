# cook your dish here
MAX = 10**6 + 1

# Step 1: Sieve to count distinct prime factors
spf = [0] * MAX
for i in range(2, MAX):
    if spf[i] == 0:  # i is prime
        for j in range(i, MAX, i):
            spf[j] += 1

T = int(input())
for _ in range(T):
    n, m = map(int, input().split())
    energy = sum(spf[n:m])
    print(energy)
